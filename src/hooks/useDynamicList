import { useCallback } from "react";

export default function useDynamicList(list, setList) {
    const addItem = useCallback(
        (createNewItem) => {
            const newItem = createNewItem();
            setList((prevList) => [...prevList, newItem])
        },
        [setList],
    )

    const updateItem = useCallback(
        (updatedItem, id) => {
            setList(prevList => prevList.map((item) => item.id === id ? updatedItem : item))
        },
        [setList],
    )

    const deleteItem = useCallback(
        (deletedItem) => {
            setList(prevList => {
                return prevList.filter(item => item.id != deletedItem.id)})
        },
        [setList],
    )

    const addNestedItem = useCallback(
        (itemID, key, createNewSubItem) => {
            setList(prevList => prevList.map(item =>
                item.id === itemID ?
                {...item, [key]: [...item[key], createNewSubItem()]} : item
            ))
        },
        [setList],
    )

    const deleteNestedItem = useCallback(
        (itemID, key, nestedID) => {
            setList(prevList => prevList.map(item => 
                item.id === itemID ?
                {...item, [key]: item[key].filter(nestedItem =>
                    nestedItem.id != nestedID
                )} : item
            )
            )
        },
        [setList],
    )

    const handleNestedItemChange = useCallback(
        (item, subitemsKey, subitemID, value, key) => {
            const newNestedItem = item[subitemsKey].map((subitem) =>
            subitem.id === subitemID ? { ...subitem, [key]: value } : subitem
        );
    updateItem({ ...item, [subitemsKey]: newNestedItem }, item.id );
  },
  [setList],
)

    return { addItem, updateItem, deleteItem, addNestedItem, deleteNestedItem, handleNestedItemChange };
}